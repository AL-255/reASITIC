const char help_general_heading[]="Type:  help <category> for a list of commands in one of the following categories";
const char help_general_categories[]="Catagories:  Create, Graphics, Session, Export, Edit, Calc, Opt";
const char help_category_heading[]="For more information, type 'help <command>'.  <command> is one of the following:";
const char* const help_categories[7][2]={
{"CREATE","\nSquare       \tCreate a square spiral inductor.\nSpiral       \tCreate a n-sided polygon spiral.\nSymSq        \tCreate a symmetric center-tapped square inductor.\nSymPoly      \tCreate a symmetric center-tapped polygon inductor.\nSqMM         \tCreate a multi-metal series square inductor\nWire         \tCreate a 'wire' (rectangle).\nVia          \tCreate a via.\nTrans        \tCreate a planar transformer.\nBalun        \tCreate a planar balun.\nCapacitor    \tCreate a metal-insulator-metal capacitor.\n3DMirrorTrans\tCreate a non-planar symmetric transformer."},
{"GRAPHICS","\nScale   \tScale the display (zoom in and out).\nPan     \tPan the display (arrow keys perform same func.)\nVPan    \tPan vertically only.\nHPan    \tPan horizontally only.\nPanOut  \tPan to origin.\nMetal   \tSelect metal layers visibility.\nRefresh \tRefresh display.\nOrigin  \tSet viewport origin (pan).\nGrid    \tToggle grid visibility and set grid size.\nBB      \tZoom to the 'bounding box'.\nVPC     \tView current viewport coordinates.\nMeas    \tMeasure distance between two points.\nShowDir \tShow direction of current flow in segments."},
{"SESSION","\nVersion        \tDisplay current ASITIC version.\nWho            \tDisplay a list of spirals in memory.\nSave           \tSave spiral(s) to disk file.\nLoad           \tLoad spiral(s) from disk file.\nCat            \tDisplay catalog of spirals in disk file.\nBSave          \tBinary save spiral(s) to disk file.\nBLoad          \tBinary load spiral(s) from disk file.\nBCat           \tDisplay catalog of spirals in binary disk file.\nLog            \tToggle the logging of the current session.\nCellSize       \tChange the current inductance cell-size.\nCCellSze       \tChange the current capacitance cell-size.\nMaxNW          \tSet maximum allowed number of sub-divisions in width of segments.\nAutoCell       \tTurn on automatic cell-size generatin mode.\nExec           \tExecute a script file.\nRecord         \tRecord the current session (delay execution).\nInput          \tRedirect keyboard input to a file.\nPrintSegs      \tPrint the segments of a spiral.\nPrintTekFile   \tPrint the current technology file.\nPause          \tPause execution specified seconds.\nOptions        \tView current options.\nVerbose        \tToggle verbosity flatg.\nChip           \tChange chip dimensions.\nEddy           \tToggle eddy current calculation mode.\nModifyLayer    \tModify technology layer parameters.\nTechIO         \tToggle data file read/write to disk."},
{"EXPORT","\nSonnetSave     \tSave geometry data into Sonnet format.\nCifSave        \tSave geometry data into CIF file."},
{"EDIT","\nSelect     \tSelect a spiral (aliases as '.').\nUnSelect   \tUn-Select a spiral.\nCopy       \tMake a copy of a spiral.\nRename     \tRename a spiral.\nFlipV      \tFlip a spiral vertically.\nFlipH      \tFlip a spiral horizontally.\nMove       \tMove (offset) a spiral.\nMoveX      \tMove a spiral in the x direction (offset).\nMoveY      \tMove a spiral in the y direction (offset).\nMoveTo     \tMove a spiral to a new location (absolute).\nRotate     \tRotate a spiral about its center.\nErase      \tErase spiral(s) from memory.\nHide       \tHide but do not erase a spiral(s).\nGeom       \tDisplay information about a spiral.\nPhase      \tChange the phase of a spiral.\nJoin       \tJoin two or more spirals in series.\nJoinShunt  \tJoin two or more spirals in shunt.\nSplit      \tSplit a spiral into two spirals.\nBefriend   \tAssociate two spirals.\nUnfriend   \tDis-associate two spirals.\nFindI      \tFind points of intersection of a spiral with itself.\nMetalArea  \tCalculate the total metal area occupied by a spiral."},
{"CALC","\nK          \tCalculate the mutual coupling between spirals.\nInd        \tCalculate the low frequency inductance of a spiral.\nRes        \tCalcualte the low frequency resistance of a spiral.\nResHF      \tCalcualte the high frequency resistance of a spiral.\nCap        \tCalculate the capacitance of a spiral.\nQ          \tCalculate the Quality factor of a spiral.\nShuntR     \tCalculate the shunt input resistance of a spiral.\nZin        \tCalculate the input impedance of a spiral.\nPi         \tCalculate a simple pi model of a spiral.\nPix        \tCalculate 2-port parameters of a spiral.\nPi2        \tCalculate 2-port parameters of a spiral.\nPi3        \tCalculate 2-port parameters of a spiral reference to gnd.\nPi4        \tCalculate 2-port parameters and extract pad parasitics.\n2Port      \tCalculate 2-port parameters over a range of frequency.\n2Portx     \tCalculate 2-port parameters over a range of frequency.\n2PortGnd   \tCalculate 2-port parameters with respect to gnd.\n2PortPad   \tCalculate 2-port parameters and 'calibrate' pad parasitics.\nCalcTrans  \tCalculate 2-port parameters of a transformer.\nTransSParam\tCalculate 2-port s-parameters of a transformer.\nSelfRes    \tCalculate self-resonant frquency of device.\n3Port      \tCalculate 3-port parameters of a balun.\nIndMat     \tCompute inductance matrix."},
{"OPT","\nOptL         \tFind an optimal square spiral.\nOptPoly      \tFind an optimal polygon spiral.\nOptSymSq     \tFind an optimal center-tapped square spiral.\nOptSymPoly   \tFind an optimal centre-tapped polygon spiral.\nSweepOpt     \tSweep geometric parameters of spiral.\nSweepOptMM   \tSweep geometric parameters of multi-metal series spiral.\nOptArea      \tOptimize the area of a spiral."},
};
